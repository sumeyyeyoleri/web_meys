# Web app environment (copy to web/.env if you need to change anything).

# Base URL of the API. Leave empty to use same-origin `/api` (Vite proxy in development,
# reverse proxy in production — recommended so session cookies stay first-party).
VITE_API_URL=

# Where the Vite dev server proxies /api and /media (development only).
VITE_DEV_API_TARGET=http://localhost:4000
