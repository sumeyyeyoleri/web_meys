// Painter & wall painting service — database schema.
//
// Deletion policy: orders and everything attached to them (attachments, messages,
// internal notes, status history) use `onDelete: Restrict` so nothing is ever
// erased silently. Orders are archived, never deleted. Translations cascade from
// their parent row. An order's optional inspiration link (a catalog item) is set
// to NULL if that item is deleted — the order itself is unaffected.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  CUSTOMER
}

/// Mapped to `nl-BE` / `en` / `tr` in packages/shared/src/locales.ts (single mapping point).
enum Locale {
  NL_BE
  EN
  TR
}

enum OrderStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_CUSTOMER_INFO
  QUOTE_SENT
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DimensionUnit {
  CM
  M
}

enum PortfolioCategory {
  PAINTING
  MURAL
  WALL_PAINTING
  PORTRAIT
  OTHER
}

/// Room or place a catalog item suits (Inspiration Catalog filter).
enum Space {
  LIVING_ROOM
  BEDROOM
  KIDS_ROOM
  KITCHEN
  CAFE_SHOP
  OFFICE
  OUTDOOR
}

enum NotificationType {
  ORDER_SUBMITTED
  ORDER_STATUS_CHANGED
  ORDER_MESSAGE
}

// ---------------------------------------------------------------------------
// Users & authentication
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(uuid()) @db.Uuid
  /// Always stored lower-cased.
  email           String   @unique
  passwordHash    String
  role            Role     @default(CUSTOMER)
  /// UI language and preferred communication language.
  preferredLocale Locale   @default(NL_BE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile             CustomerProfile?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  messages            OrderMessage[]
  internalNotes       InternalAdminNote[]
  statusChanges       OrderStatusHistory[]
  notifications       Notification[]
}

model CustomerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  fullName     String
  phone        String?
  country      String?
  city         String?
  postalCode   String?
  street       String?
  houseNumber  String?
  addressExtra String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Server-side session. Only sha256(token) is stored; the raw token lives in an HttpOnly cookie.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use, hashed, expires after one hour.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// A custom order request.
///
/// Contact details and the project address are stored ON THE ORDER as they were
/// submitted, not referenced from the customer profile: the project location can
/// differ from the customer's own address, and the order must keep showing what
/// was originally submitted even if the profile changes later.
model Order {
  id             String      @id @default(uuid()) @db.Uuid
  /// Human-readable, non-sequential reference, e.g. ORD-2026-7K3QXM.
  reference      String      @unique
  customerId     String      @db.Uuid
  /// Client-generated UUID; a repeated submission returns the existing order.
  idempotencyKey String      @db.Uuid
  status         OrderStatus @default(SUBMITTED)

  // Step 1 — service
  serviceId         String? @db.Uuid
  customRequest     String?
  /// Catalog item the customer started from ("Request something similar").
  inspirationItemId String? @db.Uuid
  /// "What would you like to change compared to the example?" (only with an inspiration item).
  additionalSpecs   String?

  // Step 2 — dimensions
  width               Decimal       @db.Decimal(10, 2)
  height              Decimal       @db.Decimal(10, 2)
  unit                DimensionUnit
  wallWidth           Decimal?      @db.Decimal(10, 2)
  wallHeight          Decimal?      @db.Decimal(10, 2)
  surfaceDetails      String?
  extraSpecifications String?

  // Step 4 — details
  title             String
  description       String
  stylePreferences  String?
  colorPreferences  String?
  themePreferences  String?
  budgetMin         Decimal?  @db.Decimal(12, 2)
  budgetMax         Decimal?  @db.Decimal(12, 2)
  deadline          DateTime? @db.Date
  extraInstructions String?

  // Step 5 — contact & project address as submitted (see model comment)
  contactName         String
  contactEmail        String
  contactPhone        String
  communicationLocale Locale
  projectCountry      String
  projectCity         String
  projectPostalCode   String
  projectStreet       String
  projectHouseNumber  String
  projectAddressExtra String?

  // Step 6 — review
  privacyAcceptedAt DateTime

  // Quote (set when moving to QUOTE_SENT)
  quoteAmount Decimal?  @db.Decimal(12, 2)
  quoteSentAt DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer        User                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service         Service?             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  inspirationItem PortfolioItem?       @relation(fields: [inspirationItemId], references: [id], onDelete: SetNull)
  attachments     OrderAttachment[]
  messages        OrderMessage[]
  internalNotes   InternalAdminNote[]
  statusHistory   OrderStatusHistory[]
  notifications   Notification[]

  @@unique([customerId, idempotencyKey])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([archivedAt])
  @@index([serviceId])
  @@index([inspirationItemId])
}

/// Customer reference image, stored in PRIVATE storage and served only through
/// GET /api/attachments/:id after an ownership check.
model OrderAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  /// Random server-side key (UUID + safe extension).
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

/// Message between customer and administrator, visible to both parties.
/// `readAt` is set when the recipient opens the thread.
model OrderMessage {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @db.Uuid
  senderId   String    @db.Uuid
  senderRole Role
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([senderRole, readAt])
}

/// Notes only administrators can see. Deliberately a separate table from OrderMessage.
model InternalAdminNote {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  /// Null for the initial SUBMITTED entry.
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String       @db.Uuid
  note        String?
  quoteAmount Decimal?     @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User  @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

/// In-app notification. Text is rendered by the web app from `type` (+ order reference / status),
/// so it always appears in the reader's current language.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  orderId   String?          @db.Uuid
  status    OrderStatus?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Service {
  id            String   @id @default(uuid()) @db.Uuid
  /// Stable technical identifier (used by the seed).
  slug          String   @unique
  isActive      Boolean  @default(true)
  isWallService Boolean  @default(false)
  imageUrl      String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translations ServiceTranslation[]
  orders       Order[]

  @@index([sortOrder])
}

model ServiceTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  serviceId   String  @db.Uuid
  locale      Locale
  name        String
  description String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
}

model PortfolioItem {
  id                  String            @id @default(uuid()) @db.Uuid
  /// Stable technical identifier (used by the seed).
  slug                String            @unique
  category            PortfolioCategory
  /// Absolute URL or a path in the public media storage (e.g. /media/portfolio/x.svg).
  imageUrl            String
  width               Decimal?          @db.Decimal(10, 2)
  height              Decimal?          @db.Decimal(10, 2)
  unit                DimensionUnit?
  year                Int?
  isFeatured          Boolean           @default(false)
  isPublished         Boolean           @default(true)
  /// Placeholder/example work — shown with a translated "Example" label.
  isSample            Boolean           @default(false)
  /// Rooms/places this work suits (catalog filter).
  spaces              Space[]           @default([])
  /// Shows the "Request something similar" button and allows orders to reference it.
  allowSimilarRequest Boolean           @default(true)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  translations   PortfolioItemTranslation[]
  inspiredOrders Order[]

  @@index([isPublished, sortOrder])
  @@index([category])
}

model PortfolioItemTranslation {
  id              String  @id @default(uuid()) @db.Uuid
  portfolioItemId String  @db.Uuid
  locale          Locale
  title           String
  description     String?

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@unique([portfolioItemId, locale])
}

/// Admin-editable text block (hero, about, privacy policy, …) per language.
model LocalizedContent {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  locale    Locale
  value     String
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

/// Single row (id = 1).
model SiteSettings {
  id                        Int      @id @default(1)
  businessName              String
  accentColor               String   @default("#E8D3A8")
  instagramUrl              String?
  contactEmail              String?
  contactPhone              String?
  contactAddress            String?
  /// nl-BE is always enabled.
  enabledLocales            Locale[] @default([NL_BE, EN, TR])
  budgetRequired            Boolean  @default(false)
  deadlineRequired          Boolean  @default(false)
  emailNotificationsEnabled Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}
