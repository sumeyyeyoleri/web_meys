# ---------------------------------------------------------------------------
# Server environment. Copy to `server/.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://painter:painter@localhost:5432/painter?schema=public
TEST_DATABASE_URL=postgresql://painter:painter@localhost:5432/painter_test?schema=public

# Long random string (at least 32 characters), e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_DAYS=14

# Origin of the web app (CORS, CSRF Origin check, links in emails)
WEB_ORIGIN=http://localhost:5173

# File storage: `local` (development) or `s3` (production)
STORAGE_DRIVER=local
# Local driver: public media (portfolio/service images) and private customer uploads
STORAGE_LOCAL_PUBLIC_DIR=./storage/public
STORAGE_LOCAL_PRIVATE_DIR=./storage/private

# S3-compatible driver (only when STORAGE_DRIVER=s3)
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
# Public base URL for objects in the public bucket (CDN or bucket URL)
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# SMTP (optional). When empty, no emails are sent and the admin settings say so.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Seed accounts (`npm run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
SEED_DEMO_CUSTOMER_EMAIL=demo.customer@example.com
SEED_DEMO_CUSTOMER_PASSWORD=change-me-demo-password
